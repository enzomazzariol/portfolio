---
import Layout from '../layouts/Layout.astro'
// Rendered on the server only (no client:* directive) — the timeline ships as plain HTML
import ExperienceSection from '../components/home/ExperienceSection.jsx'

const facts = [
  { label: 'Ubicación', value: 'Barcelona, España' },
  { label: 'Idiomas', value: 'Español, inglés' },
  { label: 'Formación', value: 'DAM · Ingeniería Audiovisual Computacional (UPF)' },
  { label: 'Disponibilidad', value: 'Abierto a puestos full stack y backend' },
]
const focusRing = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40'
---
<Layout
  title="Sobre mí — Enzo Mazzariol · Desarrollador Full Stack en Barcelona"
  description="Enzo Mazzariol, desarrollador web full stack en Barcelona. Software Developer en Guarapo Media, formado en DAM y estudiante de Ingeniería Audiovisual Computacional en la UPF."
  ogImage="https://enzomazzariol.com/assets/og-images/about-og.png"
>
  <main>

    <!-- Hero: intro + photos -->
    <section class="px-6 md:px-10 pt-36 md:pt-44 pb-24 max-w-7xl mx-auto grid md:grid-cols-12 gap-14 md:gap-10 items-center">
      <div class="md:col-span-7">
        <p class="hero-fade-down text-xs font-medium tracking-[0.18em] uppercase text-ink/50 mb-6" style="animation-delay: 0.1s">Sobre mí</p>
        <h1 class="hero-fade-up display text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95] text-ink" style="animation-delay: 0.2s">
          Enzo Mazzariol, desarrollador full stack en Barcelona
        </h1>
        <p class="hero-fade-up text-lg text-ink/65 max-w-xl leading-relaxed mt-8" style="animation-delay: 0.35s">
          Más de dos años entregando proyectos web en producción, con una base técnica en Java
          y una formación que une ingeniería y diseño.
        </p>
        <div class="hero-fade-up flex flex-wrap gap-3 mt-10 text-sm font-medium" style="animation-delay: 0.5s">
          <a href="/assets/EnzoMazzariol-CV.pdf" target="_blank" rel="noopener noreferrer" class={`bg-ink text-canvas rounded-ui px-6 py-3.5 min-h-[44px] flex items-center hover:bg-ink/85 transition-colors ${focusRing}`}>
            Descargar CV ↓
          </a>
          <a href="/contacto" class={`bg-surface text-ink border border-ink/15 hover:border-ink/40 rounded-ui px-6 py-3.5 min-h-[44px] flex items-center transition-colors ${focusRing}`}>
            Contactar →
          </a>
        </div>
      </div>

      <!-- Two prints on the table, same language as the home hero -->
      <div class="md:col-span-5 relative max-w-md mx-auto w-full pb-16 md:pb-20">
        <img
          src="/assets/me.jpeg"
          alt="Retrato de Enzo Mazzariol"
          width="1200"
          height="1086"
          class="hero-fade-up w-[85%] ml-auto rounded-tile -rotate-2 shadow-[0_30px_60px_-30px_rgb(13_13_13/0.45)]"
          style="animation-delay: 0.4s"
          fetchpriority="high"
        />
        <img
          src="/assets/me-2.jpeg"
          alt="Enzo Mazzariol corriendo una carrera"
          width="808"
          height="928"
          class="hero-fade-up absolute left-0 bottom-0 w-[45%] aspect-[4/5] object-cover object-[72%_center] rounded-tile rotate-[5deg] border-[6px] border-canvas shadow-[0_30px_60px_-30px_rgb(13_13_13/0.45)]"
          style="animation-delay: 0.6s"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Bio -->
    <section class="px-6 md:px-10 pb-24 md:pb-32 max-w-7xl mx-auto grid md:grid-cols-12 gap-10">
      <p class="reveal-view md:col-span-4 text-xs font-medium tracking-[0.18em] uppercase text-ink/50 pt-2">Perfil</p>
      <div class="reveal-view md:col-span-8 flex flex-col gap-6 text-lg text-ink/75 leading-relaxed max-w-3xl">
        <p>
          Desde 2024 trabajo como Software Developer en
          <a href="https://guarapomedia.com/" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-ink transition-colors">Guarapo Media ↗︎</a>,
          donde me encargo en solitario de los proyectos web de sus clientes: sitios en Astro y React,
          tiendas en Shopify y webs en WordPress, desde la maqueta hasta su puesta en producción.
        </p>
        <p>
          Empecé a programar en 2023 con el ciclo de Desarrollo de Aplicaciones Multiplataforma, donde
          construí <a href="/proyectos/moodflix" class="text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-ink transition-colors">Moodflix</a>,
          una app móvil con backend propio en Java y Spring Boot. Después hice prácticas en Regalexia.com,
          centradas en SEO y frontend, y hoy compagino el trabajo con el grado en Ingeniería Audiovisual
          Computacional en la UPF.
        </p>
        <p>
          Me interesa el punto donde se cruzan el código y el diseño: interfaces cuidadas, rápidas y
          accesibles, apoyadas en un backend bien estructurado. Busco un equipo donde seguir creciendo
          como desarrollador full stack.
        </p>
      </div>
    </section>

    <!-- Fact sheet -->
    <section class="band">
      <dl class="px-6 md:px-10 py-16 md:py-20 max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10">
        {facts.map(({ label, value }) => (
          <div class="reveal-view">
            <dt class="text-xs font-medium tracking-[0.18em] uppercase text-ink/45">{label}</dt>
            <dd class="display text-2xl md:text-3xl leading-tight text-ink mt-3">{value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <ExperienceSection aboutLink={false} />
  </main>
</Layout>
